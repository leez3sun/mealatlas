{
  "name": "mealatlas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "description": "A transparent, cuisine-first daily meal planning terminal.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && node scripts/verify-recipe-assets.mjs && node scripts/audit-recipe-images.mjs",
    "test:images": "python scripts/audit-recipe-images.py",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "latest"
  }
}
